# Copy to frontend/.env.local if you need to override defaults. Never put secrets here –
# every VITE_* variable is embedded in the browser bundle.

# Base path of the versioned API as seen by the browser. Keep /api/v1 in development so
# requests go through the Vite proxy below.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api requests (the FastAPI server).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
