# Root environment file used by Docker Compose (copy to .env – never commit .env).
# LOCAL DEVELOPMENT PLACEHOLDERS ONLY – choose your own password.
# backend/.env DATABASE_URL must use the same user, password, port and database name.

POSTGRES_USER=nutriplan
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=nutriplan
POSTGRES_TEST_DB=nutriplan_test
POSTGRES_HOST_PORT=5433
