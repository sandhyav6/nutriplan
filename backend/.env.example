# Copy to backend/.env – LOCAL DEVELOPMENT VALUES ONLY. Never commit backend/.env.
# These values must match the root .env used by Docker Compose.

APP_NAME=NutriPlan API
ENVIRONMENT=development
LOG_LEVEL=INFO

# postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_HOST_PORT>/<POSTGRES_DB>
DATABASE_URL=postgresql+psycopg://nutriplan:local_dev_only_change_me@127.0.0.1:5433/nutriplan

# Dedicated database for integration tests (created by docker/postgres/init). Leave empty to skip them.
TEST_DATABASE_URL=postgresql+psycopg://nutriplan:local_dev_only_change_me@127.0.0.1:5433/nutriplan_test

# Comma-separated browser origins allowed by CORS (the Vite dev server proxies /api, so this is a fallback).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
